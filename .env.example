# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/bibliotheque_db

# Sécurité JWT (générer avec: openssl rand -hex 32)
SECRET_KEY=votre_secret_key_super_securisee_ici_32_caracteres_minimum

# GitHub (pour stocker les fichiers)
GITHUB_TOKEN=ghp_votre_token_github_ici
GITHUB_REPO=username/nom-du-repo
GITHUB_BRANCH=main

# Application
DEBUG=True